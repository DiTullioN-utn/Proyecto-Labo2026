Funcion DAMA <- esDama (table, fila, columna, turno)
	Definir DAMA Como Logico
	Si (turno == 1 y table[fila, columna] == " + ") o (turno == 2 y table[fila, columna] == " - ") Entonces
		DAMA <- Falso
	SiNo
		Si (turno == 1 y table[fila, columna] == " # ") o (turno == 2 y table[fila, columna] == " & ") Entonces
			DAMA <- Verdadero
		FinSi
	FinSi
FinFuncion

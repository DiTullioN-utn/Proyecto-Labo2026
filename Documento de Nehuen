									intermedioCOLUM <- intermedioCOLUM + 1
									si columna < intermedioCOLUM Entonces
										table[fila+1, intermedioCOLUM - columna] <- "[ ]"
									SiNo
										table[fila+1, columna + intermedioCOLUM] <- "[ ]"
									FinSi
